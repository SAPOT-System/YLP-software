{
  "name": "sapot-mobile-app",
  "main": "expo-router/entry",
  "version": "0.2.0",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "start": "expo start",
    "dev": "APP_VARIANT=development npx expo start",
    "android": "expo run:android",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "android:dev": "eas build --platform android --profile development",
    "android:prev": "eas build --platform android --profile preview",
    "android:prod": "eas build --platform android --profile production",
    "update:dev": "eas update --platform android --channel development",
    "update:prev": "eas update --platform android --channel preview",
    "update:prod": "eas update --platform android --channel production",
    "ios": "expo run:ios"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testTimeout": 10000
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "react-native-network-info",
          "react-native-tcp-socket",
          "react-native-webrtc",
          "@nozbe/simdjson"
        ]
      },
      "nonCNGConfigCheck": false
    }
  },
  "dependencies": {
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@expo/vector-icons": "^15.0.3",
    "@lovesworking/watermelondb-expo-plugin-sdk-52-plus": "^1.0.3",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-documents/picker": "^12.0.1",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/native": "^7.1.8",
    "axios": "^1.13.5",
    "deepmerge": "^4.3.1",
    "expo": "~54.0.33",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.12",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "input-otp-native": "^0.6.0",
    "jwt-decode": "^4.0.0",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-device-info": "^15.0.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-network-info": "^5.2.2",
    "react-native-paper": "^5.14.5",
    "react-native-paper-dropdown": "^2.3.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-tcp-socket": "^6.3.1",
    "react-native-uuid": "^2.0.3",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-worklets": "0.5.1",
    "react-native-zeroconf": "^0.14.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-native-zeroconf": "^0.13.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "react-native": {
    "net": "react-native-tcp-socket",
    "tls": "react-native-tcp-socket",
    "fs": "react-native-tcp-socket"
  },
  "private": true,
  "packageManager": "npm@10.8.2"
}
