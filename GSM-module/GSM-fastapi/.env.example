SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=9600
# Sample database path that includes user, password, database port, and database name:
DB_PATH=mysql+pymysql://sapot:sapot@db:3306/sapot_dev 
HOST=127.0.0.1
# Code default is 8000, same as the main SAPOT server (server/runserver.sh
# binds 127.0.0.1:8000). Set this to 8001 on any host running both services
# to avoid a port collision.
PORT=8000
LOG_LEVEL=INFO
# Maximum outbound SMS requests waiting behind the one in-flight request.
# Must be an integer greater than or equal to 1.
SMS_SEND_QUEUE_MAXSIZE=10
SAPOT_API_URL=https://localhost:8000
GSM_SECRET=change-me-to-a-strong-secret
SMS_BOT_USER_ID=
