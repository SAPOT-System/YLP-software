SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=9600
DB_PATH=mysql+pymysql://sapot:__FROM_SERVER_MYSQL_PASSWORD__@db:3306/sapot
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO
# Maximum outbound SMS requests waiting behind the one in-flight request.
# Must be an integer greater than or equal to 1.
SMS_SEND_QUEUE_MAXSIZE=10
SAPOT_API_URL=https://nginx
GSM_SECRET=__FROM_SERVER_GSM_SECRET__
SMS_BOT_USER_ID=
