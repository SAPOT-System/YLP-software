GSM_SECRET=change-me-to-a-strong-secret
SERVER_ED25519_SEED=seed
JWT_SECRET_KEY=change-me-to-a-strong-random-secret

# TLS certificate paths (used by runserver.sh)
# Generate with:
#   openssl req -x509 -newkey rsa:2048 -nodes \
#     -keyout /home/sapot/certs/server.key \
#     -out /home/sapot/certs/server.crt \
#     -days 3650 -subj "/CN=192.168.0.100" \
#     -addext "subjectAltName=IP:192.168.0.100"
# Note: replace 192.168.0.100 with this server's actual LAN IP in both places above.
# Cert expiry: 3650 days from generation date.
# When renewing: regenerate cert, copy new server.crt to
#   android/app/src/main/res/raw/server_cert.pem in the app repo, then ship a new build.
TLS_CERT=/home/sapot/certs/server.crt
TLS_KEY=/home/sapot/certs/server.key

# Firebase Admin SDK service-account JSON (SAME project as the Android app).
# Used by app/db_operations/push_notifications.py to send admin FCM alerts.
FIREBASE_ADMIN_CREDENTIALS_PATH=/home/sapot/certs/firebase-admin.json
# Admin website opened when an operator taps an alert (sent as data.url).
ADMIN_WEB_URL=https://admin.sapot.example/dashboard

REDIS_URL=redis://localhost

DATABASE_URL=mysql+pymysql://sample:sample@127.0.0.1:3306/sample_db
JWT_SECRET_KEY=<hex>

ENVIRONMENT=development # e.g. production
CORS_ALLOWED_ORIGINS=*

