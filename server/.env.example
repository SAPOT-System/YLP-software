GSM_SECRET=change-me-to-a-strong-secret
SERVER_ED25519_SEED=4932ff9c160683dd1097820825f51aecc0d5c066c6b7dbbe61d8c664f0bfa940
JWT_SECRET_KEY=7a272aa19fd88943207a62115b64f67530731eafd3b79a228f42972a2a51df1e

# Only read by bare-metal runserver.sh — the Docker stack's certgen/nginx
# generate and mount their own certs instead (see docs/getting-started/docker-setup.md).
TLS_CERT=~/server.crt
TLS_KEY=~/server.key

# Defaults below point at the Docker Compose service names (`db`, `redis`)
# so `cp .env.example .env` works out of the box for docs/getting-started/docker-setup.md.
# Running bare-metal instead (docs/getting-started/server-setup.md)? Change both to 127.0.0.1/localhost.
REDIS_URL=redis://redis:6379

DATABASE_URL=mysql+pymysql://sapot:sapot@db:3306/sapot_dev

ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=*

# MariaDB container credentials (dev only — do not reuse in production).
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=sapot_dev
MYSQL_USER=sapot
MYSQL_PASSWORD=sapot
CERT_CN=localhost
CERT_SAN=DNS:localhost,IP:127.0.0.1
