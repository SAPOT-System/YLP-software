API_DOMAIN=https://<server-host>
NEXT_PUBLIC_MAP_STYLE=https://<server-host>/tiles/styles/basic-preview/style.json
NEXT_PUBLIC_WEBSOCKET_DOMAIN=wss://<server-host>
NODE_ENV=development
# Path to the CA certificate that signed the server's TLS certificate. Place the
# .pem file at this path so Node trusts renewed server certificates without disabling TLS verification globally.
NODE_EXTRA_CA_CERTS=./certs/server_ca.pem
