# Host-side port bindings for the root docker-compose.yml stack (defaults
# shown). Override to run a second stack concurrently (e.g. from a git
# worktree) without host port collisions with an already-running stack.
# `cp .env.example .env` at the repo root — docker/up.sh (and plain
# `docker compose` run from repo root) picks this up automatically.
NGINX_HTTPS_PORT=443
NGINX_HTTP_PORT=80
ADMIN_PORT=3000
GSM_FASTAPI_PORT=8001
# Canonical external URL used by TileServer GL when it generates style,
# TileJSON, glyph, sprite, and tile links. It must be the same HTTPS host
# used by NEXT_PUBLIC_MAP_STYLE and must end with /tiles/.
TILESERVER_PUBLIC_URL=https://<server-host>/tiles/
